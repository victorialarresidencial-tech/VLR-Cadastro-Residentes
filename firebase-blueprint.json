{
  "entities": {
    "Paciente": {
      "title": "Paciente / Residente",
      "description": "Registro de admissão clínica e dados de cuidados do residente da Victoria Lar Residencial.",
      "type": "object",
      "properties": {
        "nomeCompleto": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "description": "Nome completo do paciente residente"
        },
        "nomeSocial": {
          "type": "string",
          "maxLength": 100,
          "description": "Como o paciente prefere ser chamado"
        },
        "dataNascimento": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data de nascimento em formato YYYY-MM-DD"
        },
        "cpf": {
          "type": "string",
          "maxLength": 20,
          "description": "CPF do paciente"
        },
        "sexo": {
          "type": "string",
          "enum": ["feminino", "masculino", "outro"]
        },
        "quarto": {
          "type": "string",
          "maxLength": 100,
          "description": "Quarto ou leito atribuído no lar"
        },
        "dataAdmissao": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data de admissão no lar"
        },
        "status": {
          "type": "string",
          "enum": ["ativo", "avaliacao", "temporario", "alta"]
        },
        "grauDependencia": {
          "type": "string",
          "enum": ["grau1", "grau2", "grau3"]
        },
        "mobilidade": {
          "type": "string",
          "enum": ["independente", "bengala_andador", "cadeira_rodas", "acamado"]
        },
        "tipoSanguineo": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-", "desconhecido"]
        },
        "dieta": {
          "type": "string",
          "maxLength": 200
        },
        "responsavel": {
          "type": "object",
          "description": "Dados do familiar ou curador responsável"
        }
      },
      "required": [
        "nomeCompleto",
        "dataNascimento",
        "sexo",
        "quarto",
        "dataAdmissao",
        "status",
        "grauDependencia",
        "mobilidade",
        "tipoSanguineo",
        "responsavel"
      ]
    }
  },
  "firestore": {
    "/pacientes/{pacienteId}": {
      "schema": "Paciente",
      "description": "Coleção central de residentes da Victoria Lar Residencial, restrita a equipe autorizada."
    }
  }
}
